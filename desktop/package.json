{
  "name": "tinylm-studio-desktop",
  "version": "0.1.0",
  "description": "Desktop UI for tinylm-studio.",
  "private": true,
  "main": "dist/main/main.js",
  "desktopName": "tinylm-studio.desktop",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json"
  },
  "devDependencies": {
    "@tabler/icons-webfont": "^3.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "author": "Serhii <sr@ios.in.ua>",
  "homepage": "https://dev.ios.in.ua/redacid/tinylm-studio",
  "build": {
    "appId": "ua.in.ios.tinylm-studio",
    "productName": "tinylm-studio",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "pyproject.toml",
          "src/**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": [
          "lib.sh",
          "setup-engine.sh"
        ]
      },
      {
        "from": "dist/build-commit",
        "to": "build-commit"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "tinylm-studio",
      "icon": "assets/icon.png",
      "synopsis": "Build, fine-tune and evaluate small language models",
      "description": "Chat with, fine-tune and evaluate small language models on your own data.",
      "desktop": {
        "entry": {
          "StartupWMClass": "tinylm-studio-desktop"
        }
      }
    },
    "deb": {
      "packageName": "tinylm-studio",
      "depends": [
        "python3",
        "python3-venv",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "packageName": "tinylm-studio",
      "depends": [
        "python3",
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)"
      ]
    },
    "artifactName": "tinylm-studio-${version}-${arch}.${ext}",
    "publish": null
  }
}
