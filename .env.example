# Copy to .env and fill in; `make` loads it and passes the values to the engine and the app.
# Hugging Face token (https://huggingface.co/settings/tokens): needed for gated models
# and gives faster downloads.
HF_TOKEN=
# Website crawling: proxy (http://user:pass@host:port or socks5://host:port), a browser to use
# over CDP, and the default number of requests per minute to each site.
# TINYLM_PROXY=socks5://127.0.0.1:1080
# TINYLM_CDP_URL=http://127.0.0.1:9222
# TINYLM_CRAWL_PER_MINUTE=20
# Web search for finding sites and trailers: a local SearXNG (`make searxng`, free, no key)
# or the Brave Search API (https://brave.com/search/api/, needs a key).
# TINYLM_SEARCH_PROVIDER=searxng
# TINYLM_SEARXNG_URL=http://127.0.0.1:8888
# TINYLM_BRAVE_API_KEY=
# Any other engine setting from docs/api.md can go here too, for example:
# TINYLM_THREADS=8
